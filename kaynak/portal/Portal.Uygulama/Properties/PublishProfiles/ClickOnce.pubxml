<?xml version="1.0" encoding="utf-8"?>
<!-- ClickOnce yayın profili (Video Portalı). Kullanım:
     dotnet publish kaynak/portal/Portal.Uygulama/Portal.Uygulama.csproj -p:PublishProfile=ClickOnce -p:ApplicationVersion=1.0.0.1
     InstallUrl/PublishUrl: yayın yaptığınız paylaşım (örn. \\sunucu\Yayin\VideoPortali\). Sertifika: kendi pfx'iniz (BT güvenilen yayıncıya dağıtır). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\ClickOnce\</PublishDir>
    <PublishUrl>bin\ClickOnce\</PublishUrl>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <ProductName>Video Portalı</ProductName>
    <PublisherName>Video Perisi</PublisherName>
    <SuiteName>Video Perisi</SuiteName>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <BootstrapperEnabled>false</BootstrapperEnabled>
  </PropertyGroup>
</Project>
