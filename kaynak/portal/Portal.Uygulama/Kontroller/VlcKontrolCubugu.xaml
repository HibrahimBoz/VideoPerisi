<UserControl x:Class="Portal.Uygulama.Kontroller.VlcKontrolCubugu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Loaded="KontrolCubugu_Loaded"
             Unloaded="KontrolCubugu_Unloaded"
             PreviewKeyDown="KontrolCubugu_PreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ArkaPlanFircasi" Color="#16181C" />
        <SolidColorBrush x:Key="YuzeyFircasi" Color="#1E2127" />
        <SolidColorBrush x:Key="Yuzey2Fircasi" Color="#262A31" />
        <SolidColorBrush x:Key="KenarlikFircasi" Color="#343942" />
        <SolidColorBrush x:Key="MetinFircasi" Color="#E8EAED" />
        <SolidColorBrush x:Key="SolukMetinFircasi" Color="#9AA0A8" />
        <SolidColorBrush x:Key="VurguFircasi" Color="#FF8800" />
        <SolidColorBrush x:Key="VurguHoverFircasi" Color="#FFA033" />
        <FontFamily x:Key="SimgeYaziTipi">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="SimgeDugme" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource SimgeYaziTipi}" />
        </Style>
        <Style x:Key="VlcDugme" TargetType="{x:Type Button}" BasedOn="{StaticResource SimgeDugme}">
            <Setter Property="Background" Value="{DynamicResource Yuzey2Fircasi}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KenarlikFircasi}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="VlcOynatDugmesi" TargetType="{x:Type Button}" BasedOn="{StaticResource SimgeDugme}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Foreground" Value="{DynamicResource ArkaPlanFircasi}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="Daire" Fill="{DynamicResource VurguFircasi}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Daire" Property="Fill" Value="{DynamicResource VurguHoverFircasi}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Daire" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VlcSlider" TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="{DynamicResource VurguFircasi}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource YuzeyFircasi}"
            BorderBrush="{DynamicResource KenarlikFircasi}"
            BorderThickness="0,1,0,0"
            Padding="12,7,12,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="GecenSure" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SolukMetinFircasi}" FontSize="11" Text="00:00" />
                <Slider x:Name="AramaKaydiraci" Grid.Column="1" Style="{DynamicResource VlcSlider}"
                        Minimum="0" Maximum="1" ValueChanged="AramaKaydiraci_DegerDegisti"
                        PreviewMouseLeftButtonDown="AramaKaydiraci_SuruklemeBasladi"
                        PreviewMouseLeftButtonUp="AramaKaydiraci_SuruklemeBitti"
                        MouseMove="AramaKaydiraci_FareHareketi" />
                <TextBlock x:Name="KalanSure" Grid.Column="2" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource SolukMetinFircasi}"
                           FontSize="11" Text="00:00" />
            </Grid>
            <DockPanel Grid.Row="1" LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OynatDuraklatDugmesi" Style="{DynamicResource VlcOynatDugmesi}"
                            Content="&#xE768;" ToolTip="Oynat / Duraklat" Click="OynatDuraklat_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE71A;" ToolTip="Dur"
                            Click="Dur_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE892;" ToolTip="10 saniye geri"
                            Click="Geri_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE893;" ToolTip="10 saniye ileri"
                            Click="Ileri_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE76C;" ToolTip="Sonraki kare"
                            Click="SonrakiKare_Click" />
                    <Separator Margin="7,8" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="SesDugmesi" Style="{DynamicResource SimgeDugme}" Content="&#xE767;"
                            ToolTip="Sessiz" Click="Sessiz_Click" />
                    <Slider x:Name="SesKaydiraci" Width="100" Minimum="0" Maximum="100"
                            Style="{DynamicResource VlcSlider}" ValueChanged="SesKaydiraci_DegerDegisti" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE8D6;" ToolTip="Ses parçası"
                            Click="SesParcasi_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE7F0;" ToolTip="Altyazı"
                            Click="Altyazi_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE713;" ToolTip="En-boy oranı"
                            Click="EnBoy_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xEC4A;" ToolTip="Oynatma hızı"
                            Click="Hiz_Click" />
                    <Button x:Name="DonguDugmesi" Style="{DynamicResource SimgeDugme}" Content="&#xE8EE;" ToolTip="Döngü"
                            Click="Dongu_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="A-B" ToolTip="A-B tekrarı"
                            Click="AB_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE722;" ToolTip="Anlık görüntü"
                            Click="AnlikGoruntu_Click" />
                    <Button Style="{DynamicResource SimgeDugme}" Content="&#xE740;" ToolTip="Tam ekran"
                            Click="TamEkran_Click" />
                </WrapPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
