<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Portal.Uygulama.Temalar.PencereKabugu">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tema.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Başlık Çubuğu Simge Durumuna Al / Büyüt Düğmeleri Stili -->
    <Style x:Key="PencereBaslikDugmesi" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Yuzey2Fircasi}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource KenarlikFircasi}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Başlık Çubuğu Kapat Düğmesi Stili (Hover'da #E5484D kırmızı dolgu) -->
    <Style x:Key="PencereKapatDugmesi" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5484D"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C53030"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Portal Pencere Ana Stili (WindowChrome + Özel Başlık Çubuğu) -->
    <Style x:Key="PortalPencere" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource ArkaPlanFircasi}"/>
        <Setter Property="Foreground" Value="{DynamicResource MetinFircasi}"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="PencereKoku"
                            Background="{DynamicResource ArkaPlanFircasi}"
                            BorderBrush="{DynamicResource KenarlikFircasi}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Üst Özel Başlık Çubuğu (#101216 zemin, 1px alt kenarlık) -->
                            <Border Grid.Row="0"
                                    Background="#101216"
                                    BorderBrush="{DynamicResource KenarlikFircasi}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Solda turuncu video simgesi + Title metni -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                                        <TextBlock Text="&#xE714;"
                                                   FontFamily="{StaticResource SimgeYaziTipi}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource VurguFircasi}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   Foreground="{DynamicResource MetinFircasi}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Orta: WindowChrome sürükleme ve çift tık yakalama alanı -->
                                    <Grid Grid.Column="1" Background="Transparent"/>

                                    <!-- Sağda üç pencere kontrol düğmesi -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Button x:Name="SimgeDurumunaAlDugmesi"
                                                Style="{StaticResource PencereBaslikDugmesi}"
                                                ToolTip="Simge durumuna küçült"
                                                Click="SimgeDurumunaAl_Click"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource SimgeYaziTipi}" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="BuyutDugmesi"
                                                Style="{StaticResource PencereBaslikDugmesi}"
                                                ToolTip="Ekranı kapla"
                                                Click="BuyutGeriYukle_Click"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <TextBlock x:Name="BuyutDugmesiSimge" Text="&#xE922;" FontFamily="{StaticResource SimgeYaziTipi}" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="KapatDugmesi"
                                                Style="{StaticResource PencereKapatDugmesi}"
                                                ToolTip="Kapat"
                                                Click="Kapat_Click"
                                                WindowChrome.IsHitTestVisibleInChrome="True">
                                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource SimgeYaziTipi}" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Alt Kısım İçerik (#16181C) -->
                            <Border Grid.Row="1" Background="{DynamicResource ArkaPlanFircasi}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Ekranı kaplama taşma payı düzeltmesi (7px) ve simge değişimi -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PencereKoku" Property="Padding" Value="7"/>
                            <Setter TargetName="PencereKoku" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="BuyutDugmesiSimge" Property="Text" Value="&#xE923;"/>
                            <Setter TargetName="BuyutDugmesi" Property="ToolTip" Value="Önceki boyuta getir"/>
                        </Trigger>
                        <!-- Yeniden boyutlanmayan pencerelerde küçült/büyüt butonlarını gizle -->
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="SimgeDurumunaAlDugmesi" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BuyutDugmesi" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="BuyutDugmesi" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Varsayılan Pencere Stili -->
    <Style TargetType="{x:Type Window}" BasedOn="{StaticResource PortalPencere}"/>

    <!-- Portal Diyalog Stili (Modal diyaloglar için NoResize, yalnızca kapat butonu) -->
    <Style x:Key="PortalDiyalog" TargetType="{x:Type Window}" BasedOn="{StaticResource PortalPencere}">
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="WindowStartupLocation" Value="CenterOwner"/>
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40"
                              ResizeBorderThickness="0"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
