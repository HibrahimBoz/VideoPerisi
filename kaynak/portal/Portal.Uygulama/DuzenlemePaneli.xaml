<UserControl x:Class="Portal.Uygulama.DuzenlemePaneli"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource YuzeyFircasi}" Foreground="{DynamicResource MetinFircasi}">
    <Border BorderBrush="{DynamicResource KenarlikFircasi}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Başlık ve Çakışma Rozeti -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="SegmentBaslikMetni" Text="Segment Düzenle"
                           FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource MetinFircasi}" VerticalAlignment="Center"/>
                <Border x:Name="CakismaRozeti" DockPanel.Dock="Right" Background="{DynamicResource HataFircasi}"
                        CornerRadius="3" Padding="6,2" Visibility="Collapsed" HorizontalAlignment="Right">
                    <TextBlock Text="⚠ ÇAKIŞMA" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                </Border>
            </DockPanel>

            <!-- Düzenleme Metin Kutusu -->
            <TextBox x:Name="SegmentMetinKutusu" Grid.Row="1"
                     MinHeight="56" MaxHeight="90" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource ArkaPlanFircasi}" Foreground="{DynamicResource MetinFircasi}"
                     BorderBrush="{DynamicResource KenarlikFircasi}"
                     Padding="6,4" FontSize="13" Margin="0,0,0,6"/>

            <!-- Butonlar ve Durum Metni -->
            <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock x:Name="DurumMetni" DockPanel.Dock="Left"
                           Foreground="{DynamicResource BasariFircasi}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
                <Button x:Name="KaydetDugmesi" Style="{StaticResource BirincilDugme}" Content="Kaydet" DockPanel.Dock="Right"
                        Padding="14,5" Margin="6,0,0,0" FontWeight="SemiBold"
                        Click="Kaydet_Click"/>
                <Button x:Name="GeriAlDugmesi" Content="Geri Al" DockPanel.Dock="Right"
                        Padding="10,5" Margin="6,0,0,0"
                        Click="GeriAl_Click"/>
                <Button x:Name="CsvAktarDugmesi" Content="CSV Dışa Aktar" DockPanel.Dock="Right"
                        Padding="10,5" Margin="6,0,0,0"
                        Click="CsvAktar_Click"/>
            </DockPanel>

            <!-- Geçmiş Paneli Başlığı -->
            <DockPanel Grid.Row="3" Margin="0,4,0,4">
                <TextBlock Text="Düzeltme Geçmişi" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SolukMetinFircasi}"/>
                <TextBlock x:Name="GecmisSayisiMetni" Text="(0)" FontSize="12" Foreground="{DynamicResource SolukMetinFircasi}" Margin="4,0,0,0"/>
            </DockPanel>

            <!-- Geçmiş Listesi -->
            <ListBox x:Name="GecmisListesi" Grid.Row="4"
                     MaxHeight="120" MinHeight="45"
                     Background="{DynamicResource ArkaPlanFircasi}" Foreground="{DynamicResource MetinFircasi}"
                     BorderBrush="{DynamicResource KenarlikFircasi}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource KenarlikFircasi}" BorderThickness="0,0,0,1" Padding="4,3">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Kullanici}" FontWeight="SemiBold" Foreground="{DynamicResource VurguFircasi}" FontSize="11"/>
                                    <TextBlock Text="{Binding TurMetni}" Foreground="{DynamicResource VurguHoverFircasi}" FontSize="11" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding ZamanMetni}" DockPanel.Dock="Right" Foreground="{DynamicResource SolukMetinFircasi}" FontSize="10" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DegisimMetni}" TextWrapping="Wrap" Foreground="{DynamicResource MetinFircasi}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
