<Window x:Class="Portal.Uygulama.OynaticiPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:Portal.Uygulama"
        Style="{StaticResource PortalPencere}"
        Title="Oynatıcı" Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="380" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Alan: Video ve Kontrol Çubuğu -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Video Alanı -->
            <Grid Grid.Row="0" Background="#101114" ClipToBounds="True">
                <vlc:VideoView x:Name="VideoGosterici" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Video Yok / Hata Uyarısı -->
                <Border x:Name="VideoUyariKutusu" Background="{DynamicResource YuzeyFircasi}" Visibility="Collapsed" Padding="20">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource MetinFircasi}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="VideoUyariMetni" Text="Video dosyası bulunamadı — yalnızca transkript gösteriliyor"
                                   FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MetinFircasi}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Kontrol Çubuğu -->
            <Border Grid.Row="1" Background="{DynamicResource YuzeyFircasi}"
                    BorderBrush="{DynamicResource KenarlikFircasi}" BorderThickness="1"
                    Padding="10,8" Margin="0,6,0,0" CornerRadius="6">
                <StackPanel>
                    <!-- İlerleme Çubuğu ve Zaman Göstergesi -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="ZamanMetni" DockPanel.Dock="Right" Text="0:00 / 0:00"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontFamily="Consolas, monospace" FontSize="13" Foreground="{DynamicResource SolukMetinFircasi}"/>
                        <Slider x:Name="ZamanKaydiraci" Style="{StaticResource VlcSlider}" Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center"
                                ValueChanged="ZamanKaydiraci_ValueChanged"
                                PreviewMouseLeftButtonDown="ZamanKaydiraci_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ZamanKaydiraci_PreviewMouseLeftButtonUp"
                                KeyUp="ZamanKaydiraci_KeyUp"/>
                    </DockPanel>

                    <!-- Alt Kontroller: Oynat, ±10 sn, Hız, Ses, Tam Ekran -->
                    <DockPanel LastChildFill="False">
                        <!-- Oynat / Duraklat -->
                        <Button x:Name="OynatDuraklatDugmesi" Style="{StaticResource BirincilDugme}" Content="▶ Oynat" Width="84" Padding="8,5"
                                Click="OynatDuraklat_Click" Margin="0,0,6,0" FontWeight="SemiBold"/>

                        <!-- ±10 sn Atlama -->
                        <Button x:Name="GeriOnSnDugmesi" Content="-10 sn" Width="60" Padding="6,5"
                                Click="GeriOnSn_Click" Margin="0,0,4,0"/>
                        <Button x:Name="IleriOnSnDugmesi" Content="+10 sn" Width="60" Padding="6,5"
                                Click="IleriOnSn_Click" Margin="0,0,12,0"/>

                        <!-- Hız Seçici (0.5, 0.75, 1, 1.25, 1.5, 2) -->
                        <TextBlock Text="Hız:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SolukMetinFircasi}"/>
                        <ComboBox x:Name="HizSecici" Width="74" Margin="0,0,14,0"
                                  SelectionChanged="HizSecici_SelectionChanged">
                            <ComboBoxItem Content="0.5×" Tag="0.5"/>
                            <ComboBoxItem Content="0.75×" Tag="0.75"/>
                            <ComboBoxItem Content="1.0×" Tag="1.0" IsSelected="True"/>
                            <ComboBoxItem Content="1.25×" Tag="1.25"/>
                            <ComboBoxItem Content="1.5×" Tag="1.5"/>
                            <ComboBoxItem Content="2.0×" Tag="2.0"/>
                        </ComboBox>

                        <!-- Ses Kontrolü -->
                        <TextBlock Text="Ses:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource SolukMetinFircasi}"/>
                        <Slider x:Name="SesKaydiraci" Style="{StaticResource VlcSlider}" Minimum="0" Maximum="100" Value="100" Width="80"
                                VerticalAlignment="Center" Margin="0,0,4,0" ValueChanged="SesKaydiraci_ValueChanged"/>
                        <TextBlock x:Name="SesMetni" Text="%100" Width="38" VerticalAlignment="Center" Foreground="{DynamicResource SolukMetinFircasi}"/>

                        <!-- Tam Ekran (F11/Esc) -->
                        <Button x:Name="TamEkranDugmesi" DockPanel.Dock="Right" Content="⛶ Tam Ekran" Padding="10,5"
                                Click="TamEkran_Click" Margin="6,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bölücü (GridSplitter) -->
        <GridSplitter x:Name="GridSplitterBolucu" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Sağ Alan: Transkript Paneli -->
        <DockPanel x:Name="TranskriptPaneli" Grid.Column="2" LastChildFill="True" Margin="6,0,0,0">
            <!-- Üst Başlık, Otomatik Kaydır Onay Kutusu ve Arama Kutusu -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Transkript" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource MetinFircasi}"/>
                    <Button x:Name="DuzenleDugmesi" Content="Düzenle" DockPanel.Dock="Right"
                            Padding="8,3" Margin="8,0,0,0" Click="Duzenle_Click" HorizontalAlignment="Right"/>
                    <CheckBox x:Name="OtoKaydirKutusu" Content="Otomatik kaydır" IsChecked="True"
                              DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Foreground="{DynamicResource SolukMetinFircasi}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Ara:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource SolukMetinFircasi}"/>
                    <TextBox x:Name="TranskriptAramaKutusu" Padding="6,4"
                             TextChanged="TranskriptAramaKutusu_TextChanged"/>
                </DockPanel>
            </StackPanel>

            <!-- Alt Durum Metni -->
            <TextBlock x:Name="TranskriptDurumMetni" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                       Foreground="{DynamicResource SolukMetinFircasi}" FontSize="12" TextWrapping="Wrap"/>

            <!-- Düzenleme Paneli -->
            <local:DuzenlemePaneli x:Name="DuzenlemeKontrolu" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,8,0,0"/>

            <!-- Efektif Segment Listesi -->
            <ListBox x:Name="TranskriptListesi"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single"
                     PreviewMouseLeftButtonUp="TranskriptListesi_PreviewMouseLeftButtonUp"
                     SelectionChanged="TranskriptListesi_SelectionChanged"
                     KeyDown="TranskriptListesi_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="SatirCerceve" Padding="6,4" Margin="2,1" CornerRadius="3" Background="Transparent">
                            <DockPanel>
                                <TextBlock Text="{Binding ZamanMetni}" DockPanel.Dock="Left"
                                           Foreground="{DynamicResource VurguFircasi}" FontFamily="Consolas, monospace"
                                           FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="CakismaRozeti" Text="[Çakışma]" DockPanel.Dock="Right"
                                           Foreground="{DynamicResource HataFircasi}" FontWeight="Bold" Margin="6,0,0,0"
                                           Visibility="Collapsed" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Metin}" TextWrapping="Wrap" Foreground="{DynamicResource MetinFircasi}"/>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Cakisma}" Value="True">
                                <Setter TargetName="CakismaRozeti" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Vurgulu}" Value="True">
                                <Setter TargetName="SatirCerceve" Property="Background" Value="{DynamicResource SeciliSatirFircasi}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
